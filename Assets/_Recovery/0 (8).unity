          m_FloatArgument: 0
          m_StringArgument: "\u041F\u0435\u0440\u0432\u0430\u044F \u0437\u0438\u043C\u0430
            \u2014 1970-\u0435, \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u0432\u0430\u043B\u0430
            \u0441\u0438\u0441\u0442\u0435\u043C \u043C\u0430\u0448\u0438\u043D\u043D\u043E\u0433\u043E
            \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0430. \u0412\u0442\u043E\u0440\u0430\u044F
            \u2014 \u043A\u043E\u043D\u0435\u0446 1980-\u0445, \u043A\u043E\u0433\u0434\u0430
            \u044D\u043A\u0441\u043F\u0435\u0440\u0442\u043D\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B

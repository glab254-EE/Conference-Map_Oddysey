            \u0441 \u0431\u043E\u043B\u0435\u0435 \u0447\u0435\u043C 10\xB2\u2075
            FLOPS \u043F\u0440\u0438 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0438
            \u043E\u0442\u043D\u043E\u0441\u044F\u0442\u0441\u044F \u043A \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0438
            \xAB\u0441\u0438\u0441\u0442\u0435\u043C \u043E\u0431\u0449\u0435\u0433\u043E
            \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F\xBB \u0441
            \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F\u043C\u0438
            \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u043E\u0441\u0442\u0438.
            \u0428\u0442\u0440\u0430\u0444 \u0437\u0430 \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u0435

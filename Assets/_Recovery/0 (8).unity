  m_text: "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E, \u0431\u0443\u0434\u0443\u0449\u0438\u0439
    \u043A\u0430\u043F\u0438\u0442\u0430\u043D! \u0412\u043F\u0435\u0440\u0435\u0434\u0438
    \u2014 8 \u043E\u0441\u0442\u0440\u043E\u0432\u043E\u0432,\n\u0438 \u043D\u0430
    \u043A\u0430\u0436\u0434\u043E\u043C \u0432\u0430\u0441 \u0436\u0434\u0451\u0442
    \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435. \u041E\u0442\u044B\u0449\u0438\u0442\u0435
    QR-\u043A\u043E\u0434 \u043E\u0441\u0442\u0440\u043E\u0432\u0430, \u043E\u0442\u0432\u0435\u0442\u044C\u0442\u0435
    \u043D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441 \u0438 \u0437\u0430\u0431\u0435\u0440\u0438\u0442\u0435

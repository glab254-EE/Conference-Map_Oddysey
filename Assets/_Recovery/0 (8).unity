  Questions:
  - Description: "\xAB\u0417\u0438\u043C\u043E\u0439 \u0418\u0418\xBB (AI Winter)
      \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u043F\u0435\u0440\u0438\u043E\u0434\u044B
      \u0440\u0435\u0437\u043A\u043E\u0433\u043E \u0441\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u044F
      \u0444\u0438\u043D\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
      \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439. \u0421\u043A\u043E\u043B\u044C\u043A\u043E
      \u0442\u0430\u043A\u0438\u0445 \u043F\u0435\u0440\u0438\u043E\u0434\u043E\u0432
      \u0431\u044B\u043B\u043E \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438?"
    options:
    - OptionText: "\u041E\u0434\u0438\u043D"
      IsCorrect: 0
      PointsGain: 0
    - OptionText: "\u0414\u0432\u0430"
      IsCorrect: 1
      PointsGain: 15
    - OptionText: "\u0422\u0440\u0438"
      IsCorrect: 0
      PointsGain: 0
    - OptionText: "\u041D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E, \u0444\u0438\u043D\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
        \u0440\u043E\u0441\u043B\u043E \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E"
      IsCorrect: 0
      PointsGain: 0

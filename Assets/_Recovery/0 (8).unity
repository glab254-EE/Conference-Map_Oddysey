  Player_Tansform: {fileID: 109835048}
  Questions:
  - Description: "\u0412 2023 \u0433\u043E\u0434\u0443 \u043A\u0440\u0443\u043F\u043D\u044B\u0439
      \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C
      \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u0438\u043A\u0438 \u0437\u0430\u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043B
      \u0443\u0442\u0435\u0447\u043A\u0443 \u043A\u043E\u043D\u0444\u0438\u0434\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u043A\u043E\u0434\u0430 \u0438 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0445
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u043E\u0432. \u041F\u0440\u0438\u0447\u0438\u043D\u043E\u0439
      \u0441\u0442\u0430\u043B\u043E \u0442\u043E, \u0447\u0442\u043E \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0438
      \u0434\u0435\u043B\u0430\u043B\u0438 \u0447\u0435\u0440\u0435\u0437 ChatGPT?"
    options:
    - OptionText: "\u0412\u0437\u043B\u0430\u043C\u044B\u0432\u0430\u043B\u0438 \u0437\u0430\u0449\u0438\u0442\u0443
        OpenAI"
      IsCorrect: 0
      PointsGain: 0
    - OptionText: "\u0412\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0438 \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0439

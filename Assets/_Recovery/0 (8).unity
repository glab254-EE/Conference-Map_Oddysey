          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: "EU AI Act \u0434\u0435\u043B\u0438\u0442 \u0441\u0438\u0441\u0442\u0435\u043C\u044B
            \u0418\u0418 \u043F\u043E \u0443\u0440\u043E\u0432\u043D\u044E \u0440\u0438\u0441\u043A\u0430:
            \u043D\u0435\u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043C\u044B\u0439,
            \u0432\u044B\u0441\u043E\u043A\u0438\u0439, \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0439,
